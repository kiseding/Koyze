# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Android release signing (provided through CI secrets or local secure storage)
/android/key.properties
/android/app/*.jks
/android/app/*.keystore

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Workers
workers/node_modules/
workers/.wrangler/
workers/dist/
workers/.dev.vars


# Development artifacts
persistence-task-*.md
lib/**/*.sh

# Local CocoaPods gems (portable ruby). Never commit.
.gems/

# Local UI preview artifacts (golden screenshot gallery) and the sandbox-only
# macOS launch scripts. Not part of the app; gallery_test.dart also triggers an
# `invalid_use_of_visible_for_testing_member` analyzer warning that would fail
# the `flutter analyze --no-fatal-infos` step in CI.
tool/ui_preview/
tool/run_macos_preview.sh
tool/run_macos_preview.command

# Local simulator screenshots, never commit.
.tmp-ui/

# Local soft-render screenshot harness (needs Windows fonts).
test/ui_screenshot_test.dart

# Web 构建产物：`scripts/build-web.sh` 生成的 Flutter Web 包，约 50 MB，
# 由 CI / 本地构建重建，不入库。
webapp/public/
webapp/public_release/

# Kotlin 增量编译缓存（AGP 8.x 在 android/ 下生成）
android/.kotlin/

# 鸿蒙原生库输出目录：由 flutter build hap 与 scripts/ohos/stage-libmpv.sh 生成
/ohos/entry/libs/

# ohos 工程的本地产物。oh_modules 是 ohpm 依赖树，BuildProfile.ets 与
# oh-package-lock.json5 由 DevEco/ohpm 在构建期生成；第三方的 build/ 是
# hvigor 增量缓存。三者都能重建，入错库会让每个插件的 diff 噪音不断。
third_party/*/ohos/oh_modules/
third_party/*/ohos/build/
third_party/*/ohos/BuildProfile.ets
third_party/*/ohos/oh-package-lock.json5

# arm64-v8a 和 x86_64 的 libmpv 均随仓库分发，供 CI 打包。

# flutter_tools 写入的机器状态（是否是 CI bot），随环境变化。
/.flutter_tool_state

# 本地 CI 校验用的临时解包目录
/ci_tmp/

# rawfile 是 flutter_tools 在构建期生成的（flutter_assets 约 120MB，外加它
# 从 base/profile 搬过来的 buildinfo.json5）。体积大且每轮重建，不入库。
/ohos/entry/src/main/resources/rawfile/
