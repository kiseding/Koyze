# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Android release signing (provided through CI secrets or local secure storage)
/android/key.properties
/android/app/*.jks
/android/app/*.keystore

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Workers
workers/node_modules/
workers/.wrangler/
workers/dist/
workers/.dev.vars


# Development artifacts
persistence-task-*.md
lib/**/*.sh

# Local CocoaPods gems (portable ruby). Never commit.
.gems/

# Local UI preview artifacts (golden screenshot gallery) and the sandbox-only
# macOS launch scripts. Not part of the app; gallery_test.dart also triggers an
# `invalid_use_of_visible_for_testing_member` analyzer warning that would fail
# the `flutter analyze --no-fatal-infos` step in CI.
tool/ui_preview/
tool/run_macos_preview.sh
tool/run_macos_preview.command

# Local simulator screenshots, never commit.
.tmp-ui/
