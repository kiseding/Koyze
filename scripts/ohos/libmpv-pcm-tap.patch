@@ -1921,6 +1921,64 @@ static int mp_property_audio_out_params(void *ctx, struct m_property *prop,
     return r;
 }

+#if HAVE_OHOS
+static int mp_property_pcm_tap_frame(void *ctx, struct m_property *prop,
+                                     int action, void *arg)
+{
+    MPContext *mpctx = ctx;
+    if (action == M_PROPERTY_GET_TYPE) {
+        *(struct m_option *)arg = (struct m_option){.type = CONF_TYPE_NODE};
+        return M_PROPERTY_OK;
+    }
+    if (action != M_PROPERTY_GET && action != M_PROPERTY_GET_NODE)
+        return M_PROPERTY_NOT_IMPLEMENTED;
+    if (!mpctx->ao)
+        return M_PROPERTY_UNAVAILABLE;
+
+    int rate, format;
+    struct mp_chmap channels;
+    ao_get_format(mpctx->ao, &rate, &format, &channels);
+    if (channels.num <= 0 || channels.num > AO_PCM_TAP_MAX_STRIDE / 4 ||
+        (format != AF_FORMAT_FLOAT && format != AF_FORMAT_S32 &&
+         format != AF_FORMAT_S16 && format != AF_FORMAT_U8))
+        return M_PROPERTY_UNAVAILABLE;
+
+    struct ao_pcm_tap tap = {
+        .capacity = AO_PCM_TAP_FRAMES * channels.num * af_fmt_to_bytes(format),
+    };
+    tap.data = talloc_size(NULL, tap.capacity);
+    if (ao_control(mpctx->ao, AOCONTROL_GET_PCM_TAP, &tap) != CONTROL_OK) {
+        talloc_free(tap.data);
+        return M_PROPERTY_UNAVAILABLE;
+    }
+
+    mpv_node *node = arg;
+    node_init(node, MPV_FORMAT_NODE_MAP, NULL);
+    node_map_add_int64(node, "sample_rate", tap.rate);
+    node_map_add_int64(node, "channels", tap.channels);
+    node_map_add_int64(node, "pts_ns", tap.timestamp);
+    mpv_byte_array *samples = node_map_add(node, "samples", MPV_FORMAT_BYTE_ARRAY)->u.ba;
+    int count = tap.frames * tap.channels;
+    samples->size = count * sizeof(float);
+    if (tap.format == AF_FORMAT_FLOAT) {
+        samples->data = talloc_steal(samples, tap.data);
+    } else {
+        float *out = talloc_array(samples, float, count);
+        for (int i = 0; i < count; i++) {
+            if (tap.format == AF_FORMAT_S16)
+                out[i] = ((int16_t *)tap.data)[i] / 32768.0f;
+            else if (tap.format == AF_FORMAT_S32)
+                out[i] = ((int32_t *)tap.data)[i] / 2147483648.0f;
+            else
+                out[i] = (((uint8_t *)tap.data)[i] - 128) / 128.0f;
+        }
+        samples->data = out;
+        talloc_free(tap.data);
+    }
+    return M_PROPERTY_OK;
+}
+#endif
