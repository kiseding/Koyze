@@ -134,6 +189,7 @@ static int init(struct ao* ao)
     struct priv* p = ao->priv;
     OH_AudioStream_Result res = 0;

+    mp_mutex_init(&p->tap_lock);
     res = OH_AudioStreamBuilder_Create(&p->builder, AUDIOSTREAM_TYPE_RENDERER);

     if (res != AUDIOSTREAM_SUCCESS) {
@@ -202,6 +258,8 @@ static int control(struct ao *ao, enum aocontrol cmd, void *arg)
     OH_AudioStream_Result res = 0;

     switch (cmd) {
+    case AOCONTROL_GET_PCM_TAP:
+        return read_pcm(ao, arg);
     case AOCONTROL_GET_VOLUME:
         res = OH_AudioRenderer_GetVolume(p->renderer, &volume);
         if (res != AUDIOSTREAM_SUCCESS) {
@@ -229,6 +287,9 @@ static void reset(struct ao *ao)

     OH_AudioRenderer_Pause(p->renderer);
     OH_AudioRenderer_Flush(p->renderer);
+    mp_mutex_lock(&p->tap_lock);
+    p->tap_count = 0;
+    mp_mutex_unlock(&p->tap_lock);
     reset_timing(p);
 }

diff --git a/player/command.c b/player/command.c
index 1efb810..20e69ba 100644
--- a/player/command.c
