         MP_TIME_S_TO_NS(samples + p->queued_frames) / ao->samplerate;
-    ao_read_data(ao, &audioData, samples, end_time, NULL, true, true);
+    int copied = ao_read_data(ao, &audioData, samples, end_time, NULL, true, true);
