diff --git a/audio/out/ao.h b/audio/out/ao.h
index ce044fd..6812d0c 100644
--- a/audio/out/ao.h
+++ b/audio/out/ao.h
@@ -34,8 +34,20 @@ enum aocontrol {
     AOCONTROL_SET_MUTE,
     // Has char* as argument, which contains the desired stream title.
     AOCONTROL_UPDATE_STREAM_TITLE,
+    // Drains recent, interleaved PCM from a visualization-capable AO.
+    AOCONTROL_GET_PCM_TAP,
 };

+struct ao_pcm_tap {
+    void *data;
+    size_t capacity;
+    int frames, channels, rate, format;
+    int64_t timestamp;
+};
+
+#define AO_PCM_TAP_FRAMES 8192
+#define AO_PCM_TAP_MAX_STRIDE (16 * 4)
+
 // If set, then the queued audio data is the last. Note that after a while, new
 // data might be written again, instead of closing the AO.
 #define PLAYER_FINAL_CHUNK 1
diff --git a/audio/out/ao_ohaudio.c b/audio/out/ao_ohaudio.c
index 5010eef..83f530b 100644
--- a/audio/out/ao_ohaudio.c
+++ b/audio/out/ao_ohaudio.c
@@ -41,8 +41,61 @@ struct priv {
     bool timestamp_valid;

     int encoding_type;
+    mp_mutex tap_lock;
+    int tap_write, tap_count;
+    int64_t tap_timestamp;
+    unsigned char tap_data[AO_PCM_TAP_FRAMES * AO_PCM_TAP_MAX_STRIDE];
 };

+static void capture_pcm(struct ao *ao, const unsigned char *data, int frames,
+                        int64_t timestamp)
+{
+    struct priv *p = ao->priv;
+    const size_t stride = ao->sstride;
+    // Never wait for the visualization consumer on the audio thread.
+    if (frames <= 0 || stride > AO_PCM_TAP_MAX_STRIDE ||
+        mp_mutex_trylock(&p->tap_lock))
+        return;
+    if (frames > AO_PCM_TAP_FRAMES) {
+        data += (frames - AO_PCM_TAP_FRAMES) * stride;
+        frames = AO_PCM_TAP_FRAMES;
+    }
+    int first = MPMIN(frames, AO_PCM_TAP_FRAMES - p->tap_write);
+    memcpy(p->tap_data + p->tap_write * stride, data, first * stride);
+    memcpy(p->tap_data, data + first * stride, (frames - first) * stride);
+    p->tap_write = (p->tap_write + frames) % AO_PCM_TAP_FRAMES;
+    p->tap_count = MPMIN(p->tap_count + frames, AO_PCM_TAP_FRAMES);
+    p->tap_timestamp = timestamp;
+    mp_mutex_unlock(&p->tap_lock);
+}
+
+static int read_pcm(struct ao *ao, struct ao_pcm_tap *tap)
+{
+    struct priv *p = ao->priv;
+    const size_t stride = ao->sstride;
+    if (!stride || stride > AO_PCM_TAP_MAX_STRIDE)
+        return CONTROL_ERROR;
+    mp_mutex_lock(&p->tap_lock);
+    int frames = p->tap_count;
+    if (!frames || frames * stride > tap->capacity) {
+        mp_mutex_unlock(&p->tap_lock);
+        return CONTROL_ERROR;
+    }
+    int start = (p->tap_write + AO_PCM_TAP_FRAMES - frames) % AO_PCM_TAP_FRAMES;
+    int first = MPMIN(frames, AO_PCM_TAP_FRAMES - start);
+    memcpy(tap->data, p->tap_data + start * stride, first * stride);
+    memcpy((unsigned char *)tap->data + first * stride, p->tap_data,
+           (frames - first) * stride);
+    tap->timestamp = p->tap_timestamp;
+    p->tap_count = 0;
+    mp_mutex_unlock(&p->tap_lock);
+    tap->frames = frames;
+    tap->channels = ao->channels.num;
+    tap->rate = ao->samplerate;
+    tap->format = ao->format;
+    return CONTROL_OK;
+}
+
 static void reset_timing(struct priv *p)
 {
     p->last_query = 0;
@@ -71,6 +124,7 @@ static void uninit(struct ao* ao)
         p->builder = NULL;
     }

+    mp_mutex_destroy(&p->tap_lock);
     reset_timing(p);
 }

